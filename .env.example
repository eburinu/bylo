# OpenAI-совместимый эндпоинт: OpenRouter, DeepSeek и т.п.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# id моделей соседей через запятую — точные id смотреть на openrouter.ai/models.
# Берите по одной модели из разных семейств (Claude, GPT, Gemini, DeepSeek, Qwen):
# чем больше семейств, тем честнее выборка.
LLM_MODELS=
# быстрая дешёвая модель для нормализации, судьи и поворота
LLM_UTIL_MODEL=
EMBED_MODEL=intfloat/multilingual-e5-small
